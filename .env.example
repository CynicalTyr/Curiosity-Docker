# Copy to .env next to docker-compose.yml. Never commit .env.

# Required. Long random string; share with the agent / MCP adapter only.
USERNAME_DISCOVERY_API_KEY=change-me-long-random-string

# Comma-separated IPs allowed to call /health and /scan.
# Use 127.0.0.1 when the MCP adapter runs on the same host (Linux host network).
# Use * with docker-compose.bridge.yml (API key + loopback publish only).
USERNAME_DISCOVERY_ALLOWED_IPS=127.0.0.1

# Optional overrides
# USERNAME_DISCOVERY_BIND=0.0.0.0
# USERNAME_DISCOVERY_PORT=8095
# USERNAME_DISCOVERY_SCAN_TIMEOUT=60
# USERNAME_DISCOVERY_PUBLISH=127.0.0.1:8095
